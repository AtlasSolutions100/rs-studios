# The dependency ranges Campaignify accepts. Not installed directly: requirements.txt is
# the lock compiled from this file (exact versions + sha256 hashes) that the image and
# CI install. After editing this file:
#
#    uv pip compile requirements.in --generate-hashes --strip-extras --python-version 3.12 --python-platform linux -o requirements.txt
#
# then commit both files. CI (tests + pip-audit) runs on the new lock.
