{
    servers {
        timeouts {
            read_header 15s
            idle 2m
        }
    }
}

{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 160MB
    }
    reverse_proxy app:8080 {
        request_buffers 8MB
        transport http {
            dial_timeout 5s
            response_header_timeout 2m
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
